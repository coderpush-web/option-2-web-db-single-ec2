# Environment Configuration Template for Option 2 (Web EC2 + Embedded SQLite)

# NextAuth session encryption secret (minimum 32-character random string)
# Generated dynamically in AWS Secrets Manager: ${EnvironmentName}-web-auth-secret
AUTH_SECRET=your_32_character_nextauth_secret_key_here

# Canonical base URL for NextAuth authentication redirects
AUTH_URL=http://localhost:3000

# Path to persistent local SQLite database file
# In Docker, mounted to persistent EBS host volume: /var/data/sqlite:/app/data
SQLITE_DB_PATH=/app/data/app.db

# Application environment tier (development | staging | production)
APP_ENV=development

# Application listening port (defaults to 80 in Docker, 3000 in local dev)
PORT=3000

# Optional initial administrator password for seeding local SQLite database
# INITIAL_USER_PASSWORD=your_secure_admin_password
